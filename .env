# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:secret@database:5432/sendvery?serverVersion=17"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=messages
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025

# Envelope sender and From address for everything the app sends. Must be an
# address the MAILER_DSN account is allowed to send as: a mail server that
# enforces sender ownership answers "553 Sender address rejected" and the
# message dies in the retry queue, which for magic-link auth means nobody can
# sign in. Self-hosters set this to an address on their own domain.
MAILER_SENDER=robot@sendvery.com
###< symfony/mailer ###

###> sendvery/reports-ingestion ###
# Email address customers point their DMARC `rua=` at. Used in onboarding
# instructions and dashboard hints. Self-hosters set this to their own inbox.
SENDVERY_REPORT_ADDRESS=reports@sendvery.com

# Where notifications about domain-ownership inquiries land. The "Notify
# admin" button on the "domain already monitored" page sends here.
SENDVERY_ADMIN_EMAIL=jan.mikes@sendvery.com

# Central reports inbox (Seznam Email Profi by default). Leave USERNAME
# blank to disable the central inbox — only BYO mailbox connections will
# be polled. Self-hosters that don't want a central inbox can ignore the
# rest of these settings.
SENDVERY_REPORTS_INBOX_HOST=
SENDVERY_REPORTS_INBOX_PORT=993
SENDVERY_REPORTS_INBOX_USERNAME=
SENDVERY_REPORTS_INBOX_PASSWORD=
SENDVERY_REPORTS_INBOX_ENCRYPTION=ssl
SENDVERY_REPORTS_INBOX_PROCESSED_FOLDER=Sendvery/Processed
SENDVERY_REPORTS_INBOX_FAILED_FOLDER=Sendvery/Failed
SENDVERY_REPORTS_INBOX_JUNK_FOLDER=Sendvery/Junk
SENDVERY_REPORTS_INBOX_BATCH_SIZE=200
SENDVERY_REPORTS_INBOX_MAX_MESSAGE_BYTES=26214400

# Quarantined reports for unverified/unrecognized domains are kept this long.
SENDVERY_QUARANTINE_TTL_DAYS=60
# Parsed envelopes are purged from DB and from the Processed IMAP folder after this many days.
SENDVERY_ENVELOPE_PURGE_AFTER_DAYS=30
###< sendvery/reports-ingestion ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
# Release version reported to Sentry. Wire to your build/commit SHA in CI.
SENTRY_RELEASE=
# Fraction of requests/messages to trace (0.0 – 1.0). Keep low in production.
SENTRY_TRACES_SAMPLE_RATE=0
# Shared secret to enable on-demand profiling via ?_profile=<secret>.
# Leave empty to disable the toggle. Generate with: php -r "echo bin2hex(random_bytes(16));"
SENTRY_PROFILING_SECRET=
###< sentry/sentry-symfony ###

###> sendvery/credential-encryption ###
# 32-byte key, base64-encoded. Generate with: php -r "echo base64_encode(random_bytes(32));"
ENCRYPTION_KEY="YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="
###< sendvery/credential-encryption ###

###> stripe ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Prices are NOT configured via env vars. The app resolves prices at runtime
# by Stripe lookup key (sendvery_<tier>[_ai]_<monthly|annual>) through the
# Prices API — the same keys exist in both sandbox and live, so there are no
# per-environment price IDs to manage. Provision products + prices with
# `scripts/provision-stripe.sh` (see docs/14-stripe-setup.md). Only the secret
# key selects which mode (sandbox vs. live) the keys resolve against.

###< stripe ###

###> anthropic ###
# Presence of ANTHROPIC_API_KEY is the AI-purchasable gate (DEC-057):
# when set, real AI is wired and AI plan variants are purchasable +
# the pricing-page AI toggle is visible. When unset, AI variants are
# hidden and StripePriceResolver throws AiNotYetPurchasable.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# Balanced model tiering: Sonnet for customer-facing narratives, Haiku for
# high-volume/simple tasks. Any task can be flipped to claude-opus-4-8 to A/B
# it on Opus without a code change.
ANTHROPIC_MODEL_EXPLAIN_REPORT=claude-sonnet-4-6
ANTHROPIC_MODEL_EXPLAIN_ANOMALY=claude-sonnet-4-6
ANTHROPIC_MODEL_WEEKLY_DIGEST=claude-sonnet-4-6
ANTHROPIC_MODEL_REMEDIATION=claude-haiku-4-5
ANTHROPIC_MODEL_SENDER_LABEL=claude-haiku-4-5
###< anthropic ###

###> cloudflare ###
# Cloudflare API credentials for automated RFC 7489 authorization
# record management. Leave both empty to disable — self-hosters
# without Cloudflare must publish records manually.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
###< cloudflare ###

###> google-analytics ###
GOOGLE_ANALYTICS_ID=
###< google-analytics ###

###> sendvery/browser-tests ###
# Shared secret for /_test/login, the login bypass the Playwright smoke suite
# uses (the product has magic-link-only auth, throttled to 5/hour and silent
# past the cap). EMPTY HERE ON PURPOSE: this is the value every environment
# inherits, so an unconfigured deployment — production included — has no usable
# endpoint. A value is set only in .env.dev and .env.test, neither of which is
# loaded when APP_ENV=prod, and the controller additionally refuses any
# environment that is not dev or test.
SENDVERY_TEST_LOGIN_SECRET=
###< sendvery/browser-tests ###

###> symfony/routing ###
# The app's public base URL. Two things depend on it:
#   1. framework.router.default_uri — every absolute URL generated OUTSIDE an
#      HTTP request. All email is rendered by cron/messenger handlers, so every
#      link in every email comes from here. Leave it at a localhost value in
#      production and the weekly digest ships unclickable localhost links.
#   2. Stripe checkout / billing-portal return URLs.
# Production MUST override this (host env var or .env.local):
#   DEFAULT_URI=https://sendvery.com
# Local dev: compose maps the app container's port 80 to ${WEB_PORT:-80}.
DEFAULT_URI=http://localhost
###< symfony/routing ###
